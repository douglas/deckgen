#!/usr/bin/env bash
# Export a deck to PDF (one page per slide) with headless Chromium.
# Usage: bin/export-pdf <deck.html> [theme] [mode]
set -euo pipefail

deck="${1:?usage: bin/export-pdf <deck.html> [theme] [mode]}"
theme="${2:-midnight}"
mode="${3:-light}"
src="$(realpath "$deck")"
out="${src%.html}.pdf"

browser="${DECKGEN_CHROME:-}"
if [ -z "$browser" ]; then
  for name in chromium chromium-browser google-chrome google-chrome-stable chrome; do
    if command -v "$name" >/dev/null 2>&1; then browser="$name"; break; fi
  done
fi
[ -n "$browser" ] || { echo "export-pdf: no Chromium-family browser found; set DECKGEN_CHROME" >&2; exit 2; }

"$browser" --headless --disable-gpu --no-pdf-header-footer --virtual-time-budget=8000 \
  --print-to-pdf="$out" "file://$src?theme=$theme&mode=$mode" 2>/dev/null
echo "$out"
